# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection URL
# SQLite default for local run: "file:./dev.db"
# PostgreSQL for production/Docker: "postgresql://postgres:postgres@localhost:5432/hireiq?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_char_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_char_string

# Optional: Google Gemini AI API Key
GEMINI_API_KEY=

# Python FastAPI AI Microservice (Port 8000)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_WORKERS=2
AI_SERVICE_CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:80
INTERNAL_API_KEY=
