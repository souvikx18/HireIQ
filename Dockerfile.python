# ============================================================
# HireIQ — Python AI Microservice Dockerfile
# Base: python:3.11-slim  |  Exposed port: 8000
# ============================================================

# ---- Stage 1: Builder ----
FROM python:3.11-slim AS builder

# System deps for spaCy / tesseract / numpy compile
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only requirements first — leverage layer cache
COPY requirements.txt .

RUN pip install --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt

# Download spaCy English model into the layer
RUN /install/bin/python -m spacy download en_core_web_sm

# ---- Stage 2: Runtime ----
FROM python:3.11-slim AS runtime

# Runtime system deps (tesseract OCR + libpq)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

WORKDIR /app

# Non-root user for security
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app

USER appuser

# Copy application source
COPY --chown=appuser:appuser . .

# Expose AI microservice port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start uvicorn
CMD ["uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
